#!/bin/bash
###############################################################################
# vnc — 用户级 VNC 管理命令
# 用法: vnc {start|stop|restart|status|passwd}
#
# DISPLAY_NUM 从 /etc/vnc-users 读取
# GEOMETRY / DEPTH 从 ~/.vnc/config 读取
# 兼容 CentOS 7.9 TigerVNC 1.x
###############################################################################
set -euo pipefail

CONFIG_FILE="$HOME/.vnc/config"
VNC_USERS_FILE="/etc/vnc-users"

# ---------- 颜色定义 ----------
# 仅当 stdout 为终端时启用颜色，避免重定向到文件时转义码污染日志
if [[ -t 1 ]]; then
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[1;34m'; NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; NC=''
fi

info() { echo -e "${BLUE}ℹ️  $*${NC}"; }
ok()   { echo -e "${GREEN}✅ $*${NC}"; }
warn() { echo -e "${YELLOW}⚠️  $*${NC}"; }
err()  { echo -e "${RED}❌ $*${NC}" >&2; }

# ---------- 加载配置 ----------
load_config() {
    # 1. 从 /etc/vnc-users 读取 DISPLAY_NUM
    if [[ ! -f "$VNC_USERS_FILE" ]]; then
        err "配置文件不存在: $VNC_USERS_FILE"
        err "请先运行: sudo vnc/run.sh"
        exit 1
    fi

    local username
    username=$(whoami)
    local user_line
    user_line=$(grep "^${username}:" "$VNC_USERS_FILE" | head -1 || true)

    if [[ -z "$user_line" ]]; then
        err "用户 '$username' 未在 $VNC_USERS_FILE 中注册"
        err "请先运行: sudo configure-user.sh $username"
        exit 1
    fi

    DISPLAY_NUM=$(echo "$user_line" | cut -d: -f2)

    if [[ -z "$DISPLAY_NUM" ]] || ! [[ "$DISPLAY_NUM" =~ ^[0-9]+$ ]]; then
        err "无效的 DISPLAY_NUM: '$DISPLAY_NUM'（来源: $VNC_USERS_FILE）"
        exit 1
    fi

    # 2. 从 ~/.vnc/config 读取 GEOMETRY / DEPTH（不再包含 DISPLAY_NUM）
    if [[ ! -f "$CONFIG_FILE" ]]; then
        err "配置文件不存在: $CONFIG_FILE"
        err "请联系管理员执行 configure-user.sh 初始化"
        exit 1
    fi

    # shellcheck disable=SC1090
    source "$CONFIG_FILE"

    GEOMETRY="${GEOMETRY:-2560x1440}"
    DEPTH="${DEPTH:-24}"
}

# ---------- 获取当前运行的 VNC 进程 ----------
get_vnc_pid() {
    pgrep -u "$(whoami)" -f "Xvnc :${DISPLAY_NUM}" 2>/dev/null || true
}

# ---------- CentOS 7.9 字体路径 ----------
get_font_path() {
    local fp=""
    local dirs=(
        "/usr/share/X11/fonts/misc"
        "/usr/share/X11/fonts/Type1"
        "/usr/share/X11/fonts/TTF"
        "/usr/share/fonts/default/Type1"
        "/usr/share/fonts/dejavu"
        "/usr/share/fonts/liberation"
        "/usr/share/X11/fonts/OTF"
        "/usr/share/X11/fonts/75dpi"
        "/usr/share/X11/fonts/100dpi"
        "built-ins"
    )
    for d in "${dirs[@]}"; do
        [[ -d "$d" ]] && fp="${fp:+$fp,}$d"
    done
    echo "${fp:-built-ins}"
}

# ---------- start ----------
do_start() {
    load_config

    local pid
    pid=$(get_vnc_pid)
    if [[ -n "$pid" ]]; then
        warn "VNC 已在运行 (PID: $pid, display :${DISPLAY_NUM})"
        return 0
    fi

    info "启动 VNC | display :${DISPLAY_NUM} | ${GEOMETRY} | depth ${DEPTH}"

    local font_path
    font_path=$(get_font_path)

    # ✅ CentOS 7.9 TigerVNC 1.x 正确语法:
    #   vncserver :<num> -geometry WxH -depth D -fp <fontpath> [其他选项]
    vncserver ":${DISPLAY_NUM}" \
        -geometry "$GEOMETRY" \
        -depth "$DEPTH" \
        -fp "$font_path" \
        -SecurityTypes VncAuth \
        -AlwaysShared \
        -AcceptKeyEvents \
        -AcceptPointerEvents \
        -SendCutText=0 \
        -AcceptCutText=0

    sleep 1

    pid=$(get_vnc_pid)
    if [[ -n "$pid" ]]; then
        ok "VNC 已启动 (PID: $pid)"
        info "连接地址: <服务器IP>:$((5900 + DISPLAY_NUM))"
    else
        err "VNC 启动失败，请检查日志:"
        err "  cat ~/.vnc/*.log"
        exit 1
    fi
}

# ---------- stop ----------
do_stop() {
    load_config

    local pid
    pid=$(get_vnc_pid)
    if [[ -z "$pid" ]]; then
        warn "VNC 未在运行 (display :${DISPLAY_NUM})"
        return 0
    fi

    info "停止 VNC (PID: $pid, display :${DISPLAY_NUM})..."
    vncserver -kill ":${DISPLAY_NUM}" 2>/dev/null || kill "$pid" 2>/dev/null || true
    sleep 1

    if get_vnc_pid &>/dev/null; then
        err "VNC 未能正常停止，尝试强制终止..."
        kill -9 "$pid" 2>/dev/null || true
    fi

    ok "VNC 已停止"
}

# ---------- restart ----------
do_restart() {
    do_stop
    sleep 1
    do_start
}

# ---------- status ----------
do_status() {
    load_config

    local pid
    pid=$(get_vnc_pid)
    if [[ -n "$pid" ]]; then
        ok "VNC 运行中 (PID: $pid, display :${DISPLAY_NUM}, port $((5900 + DISPLAY_NUM)))"
    else
        warn "VNC 未运行 (display :${DISPLAY_NUM})"
    fi
}

# ---------- passwd ----------
do_passwd() {
    info "修改 VNC 密码..."
    vncpasswd
    ok "密码已更新"
}

# ---------- main ----------
case "${1:-}" in
    start)   do_start   ;;
    stop)    do_stop    ;;
    restart) do_restart ;;
    status)  do_status  ;;
    passwd)  do_passwd  ;;
    *)
        echo "用法: vnc {start|stop|restart|status|passwd}"
        exit 1
        ;;
esac
